# Public Supabase values are included in the frontend bundle.
# Set these in Netlify with BOTH Builds and Functions scopes.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Create a fresh secret on your computer: openssl rand -hex 32
# Add to Netlify as a sensitive variable, available to Builds and Functions.
TICKET_SIGNING_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET

# Optional duplicate aliases, not needed if VITE_* are available to Functions:
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
